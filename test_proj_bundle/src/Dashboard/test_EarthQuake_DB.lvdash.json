{
  "datasets": [
    {
      "name": "535dda18",
      "displayName": "Earthquake_Detail",
      "queryLines": [
        "select * from silver.earthquake_data_final"
      ],
      "catalog": "test_dev",
      "schema": "silver"
    },
    {
      "name": "36c9d614",
      "displayName": "Magnitude_Type",
      "queryLines": [
        "select count(*) as total_magnitude_bucket,\r\n",
        "        magnitude_bucket from (select CASE\r\n",
        "          WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "          WHEN mag BETWEEN 2 AND 3 THEN 'Minor (2–3)'\r\n",
        "          WHEN mag BETWEEN 3 AND 4 THEN 'Light (3–4)'\r\n",
        "          ELSE 'Moderate+ (4+)'\r\n",
        "        END AS magnitude_bucket\r\n",
        "        from silver.earthquake_data_final )\r\n",
        "        group by magnitude_bucket"
      ],
      "catalog": "test_dev",
      "schema": "silver"
    },
    {
      "name": "112fa7d6",
      "displayName": "EQ_Country",
      "queryLines": [
        "SELECT \r\n",
        "          count(*) AS event_count,\r\n",
        "          -- CASE ,\r\n",
        "          --   WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0],\r\n",
        "          --   ELSE split(place, ', ')[1],\r\n",
        "          -- END AS country,\r\n",
        "          coalesce(\r\n",
        "            try_element_at(split(place, ', '), 2), \r\n",
        "            element_at(split(place, ', '), 1)\r\n",
        "            ) AS country\r\n",
        "        FROM (\r\n",
        "          SELECT \r\n",
        "             time,\r\n",
        "            title,\r\n",
        "            mag,\r\n",
        "            longitude,\r\n",
        "            place,\r\n",
        "            latitude\r\n",
        "          FROM silver.earthquake_data_final\r\n",
        "        )\r\n",
        "        GROUP BY country"
      ],
      "catalog": "test_dev",
      "schema": "silver"
    }
  ],
